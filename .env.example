# =============================================================================
# Customer Feedback Insights — Environment Variable Reference
# Copy this file to .env and fill in your values.
# =============================================================================

# --- Application ---
APP_ENV=development          # development | staging | production
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR | CRITICAL

# --- Backend (FastAPI) ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# Secret key used for signing tokens (generate with: openssl rand -hex 32)
SECRET_KEY=change-me-in-production-please
# CORS origins allowed to talk to the backend (comma-separated list)
BACKEND_CORS_ORIGINS=http://localhost:3000

# --- Database ---
# SQLite path relative to the backend container working directory
DATABASE_URL=sqlite:///./data/feedback.db

# --- GenAI / LLM ---
# Provider: openai | vertexai | mock
GENAI_PROVIDER=mock
# Only required when GENAI_PROVIDER=openai
OPENAI_API_KEY=sk-replace-me
OPENAI_MODEL=gpt-4o-mini

# --- Frontend (Next.js) ---
# The URL the browser uses to reach the backend API
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# The URL Next.js server-side rendering uses to reach the backend API
API_BASE_URL=http://backend:8000
